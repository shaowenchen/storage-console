PORT=3001
HOST=0.0.0.0
SESSION_SECRET=storage-console-session-secret-change-me
# Optional separate key for encrypting S3 credentials at rest (defaults to SESSION_SECRET)
CREDENTIALS_SECRET=
LOG_LEVEL=info
MAX_UPLOAD_MB=500

# Database DSN. Leave unset for SQLite at ~/.storage-console/storage-console.sqlite
# sqlite:////path/to/db.sqlite -> custom SQLite path
SQL_DSN=

# Admin key for signing in and for script/automation uploads.
# Set this to a strong random value before deploying.
ADMIN_USER_KEY=change-me
# Optional separate key used by the "Pull & Run" upload script (defaults to ADMIN_USER_KEY)
UPLOAD_KEY=
