PORT=3001
HOST=0.0.0.0
# Optional separate key for encrypting S3 credentials at rest
# (defaults to the auto-generated internal session key in SQLite)
CREDENTIALS_SECRET=
LOG_LEVEL=info
MAX_UPLOAD_MB=500

# Database DSN. Leave unset for SQLite at ~/.storage-console/storage-console.sqlite
# sqlite:////path/to/db.sqlite -> custom SQLite path
SQL_DSN=

# Admin login key (required in production). Upload/download API keys are
# auto-generated on first start and stored in SQLite; view them in the UI.
ADMIN_USER_KEY=change-me
