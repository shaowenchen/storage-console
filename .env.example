PORT=3001
HOST=0.0.0.0
# Stable secret for encrypting S3 access/secret keys at rest.
# If unset, falls back to the auto-generated session key (changes if auth_keys are recreated).
CREDENTIALS_SECRET=
LOG_LEVEL=info
# Per-file upload limit in MB. The browser enforces this before starting a
# transfer; it applies to each file individually, not to the batch total.
MAX_UPLOAD_MB=1024
# Browser uploads processed at once, and how many more may wait for a slot
# (default 4 and 16). Beyond the queue the server answers 503 + Retry-After and
# the browser backs off and re-sends, so these bound how much upload work the
# process does at once rather than how much a client may request.
# MAX_CONCURRENT_UPLOADS=4
# MAX_QUEUED_UPLOADS=16
# Timeouts for requests to the bucket, in seconds. The SDK's own default is no
# timeout at all, which makes a stalled storage indistinguishable from a slow
# one: the upload proxy stops reading the browser's body and the transfer parks
# at a fixed byte offset with no error. SOCKET counts inactivity (raise it if a
# storage legitimately goes quiet, e.g. while reassembling a multipart upload);
# REQUEST counts total duration and is only a ceiling on the absurd.
# S3_SOCKET_TIMEOUT_SECONDS=120
# S3_CONNECT_TIMEOUT_SECONDS=10
# S3_REQUEST_TIMEOUT_SECONDS=3600
# Presigned PUT/GET lifetime for direct-to-bucket transfers (seconds). Default 900.
# S3_DIRECT_UPLOAD_EXPIRES_SECONDS=900
# S3_DIRECT_DOWNLOAD_EXPIRES_SECONDS=900

# Database DSN. Leave unset for SQLite at ~/.storage-console/storage-console.sqlite
# sqlite:////path/to/db.sqlite -> custom SQLite path
# mysql://user:password@host:port/database -> MySQL 8+ / TiDB
# IMPORTANT: use a dedicated database (e.g. storage_console). Do NOT point at Studio's
# database — shared buckets/auth_keys cause credential decrypt failures.
# App tables: buckets, auth_keys (object listings come from S3, not the DB).
# mysql://user:password@host:4000/storage_console?tls=skip-verify -> TiDB Cloud / TLS skip-verify
SQL_DSN=

# Admin login key (required in production). Upload/download API keys are
# auto-generated on first start and stored in the database; view them in the UI.
ADMIN_USER_KEY=change-me
