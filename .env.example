PORT=3001
HOST=0.0.0.0
# Stable secret for encrypting S3 access/secret keys at rest.
# If unset, falls back to the auto-generated session key (changes if auth_keys are recreated).
CREDENTIALS_SECRET=
LOG_LEVEL=info
# Per-file upload limit in MB. The browser enforces this before starting a
# transfer; it applies to each file individually, not to the batch total.
MAX_UPLOAD_MB=1024
# Size of one piece of a browser upload, in MB (default 8).
#
# This is the setting that decides whether a large upload can finish at all.
# The browser used to put the whole file through this service in one request,
# and every hop in front of the service has to accept that body within its own
# request-body window — a limit essentially every proxy, load balancer and
# ingress imposes. A 1 GB body needed a sustained 28.6 Mbps to finish inside a
# typical few-minute window, so a slower upstream was cut off as an opaque 502.
# Each request is now one piece: at 8 MB it needs 0.22 Mbps to finish in that
# window, and a retry re-sends one piece instead of the whole file.
#
# Must be at least 5 (S3's minimum for a non-final part) and should stay well
# under the request-body window the proxies in front of this service enforce.
# UPLOAD_PART_MB=8
# The request-body window to assume for the size check above, in seconds
# (default 300). Only used to assert the part size leaves enough headroom; raise
# it if the proxies here are known to be more patient.
# PROXY_BODY_WINDOW_SECONDS=300
# How long an unfinished chunked upload is kept before it is cleaned up, in
# hours (default 24). An abandoned upload holds its parts in the bucket
# invisibly; the client aborts explicitly on cancel, and this bounds how long a
# token from a browser that was simply closed can still be used.
# UPLOAD_SESSION_TTL_HOURS=24
#
# Parts are spooled to a temporary file and uploaded from there, so a storage
# hiccup can be retried without asking the browser to send the bytes again.
# UPLOAD_SPOOL_DIR defaults to the system temporary directory; each process
# writes to its own subdirectory, so several instances on one host do not
# collide.
# UPLOAD_SPOOL_DIR=/tmp
# How long a part file may sit before a later process reclaims it, in minutes
# (default 60). Files are removed as soon as their request finishes on every
# path; this only covers a process that was killed outright.
# UPLOAD_SPOOL_TTL_MINUTES=60
# Attempts, per part, to get its bytes into the storage (default 4). Retries
# happen server-side, so a transient failure costs a little time rather than a
# round trip back to the browser.
# UPLOAD_PART_UPLOAD_ATTEMPTS=4
#
# NOTE on spooling and multiple instances: a part is written by whichever
# instance receives the request, and read back by that same instance, so no
# shared storage is needed between instances. Give the containers enough
# ephemeral disk for the parts in flight (a part is UPLOAD_PART_MB, and
# MAX_CONCURRENT_UPLOAD_PARTS of them at once per instance).
#
# IMPORTANT — set this lifecycle rule on the bucket itself:
#   AbortIncompleteMultipartUpload: DaysAfterInitiation: 1
# An upload whose parts are in the bucket but which is never completed leaves
# them occupying storage invisibly. The console's own cleanup only runs while it
# is up; a bucket rule is what reclaims the rest. Some S3-compatible stores do
# not support lifecycle rules — if yours does not, check for orphaned multipart
# uploads periodically.
# Browser uploads processed at once, and how many more may wait for a slot
# (default 4 and 16). Beyond the queue the server answers 503 + Retry-After and
# the browser backs off and re-sends, so these bound how much upload work the
# process does at once rather than how much a client may request.
# MAX_CONCURRENT_UPLOADS=4
# MAX_QUEUED_UPLOADS=16
# The same bounds for chunked upload parts, which are separate and much larger
# (default 16 and 32). A part is a bounded few megabytes finished in seconds,
# where the whole-file gate above was sized for requests of a gigabyte; sharing
# one small allowance would let a single browser, which opens several parts at
# once, starve every other uploader.
# MAX_CONCURRENT_UPLOAD_PARTS=16
# MAX_QUEUED_UPLOAD_PARTS=32
# Timeouts for requests to the bucket, in seconds. The SDK's own default is no
# timeout at all, which makes a stalled storage indistinguishable from a slow
# one: the upload proxy stops reading the browser's body and the transfer parks
# at a fixed byte offset with no error. SOCKET counts inactivity (raise it if a
# storage legitimately goes quiet, e.g. while reassembling a multipart upload);
# REQUEST counts total duration and is only a ceiling on the absurd.
# S3_SOCKET_TIMEOUT_SECONDS=120
# S3_CONNECT_TIMEOUT_SECONDS=10
# S3_REQUEST_TIMEOUT_SECONDS=3600
# Presigned PUT/GET lifetime for direct-to-bucket transfers (seconds). Default 900.
# S3_DIRECT_UPLOAD_EXPIRES_SECONDS=900
# S3_DIRECT_DOWNLOAD_EXPIRES_SECONDS=900

# Database DSN. Leave unset for SQLite at ~/.storage-console/storage-console.sqlite
# sqlite:////path/to/db.sqlite -> custom SQLite path
# mysql://user:password@host:port/database -> MySQL 8+ / TiDB
# IMPORTANT: use a dedicated database (e.g. storage_console). Do NOT point at Studio's
# database — shared buckets/auth_keys cause credential decrypt failures.
# App tables: buckets, auth_keys (object listings come from S3, not the DB).
# mysql://user:password@host:4000/storage_console?tls=skip-verify -> TiDB Cloud / TLS skip-verify
SQL_DSN=

# Admin login key (required in production). Upload/download API keys are
# auto-generated on first start and stored in the database; view them in the UI.
ADMIN_USER_KEY=change-me
